<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- Генерация OpenAPI отключена - вызывает ошибки при сборке в Docker -->
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>

    <!-- XML-документация для комментариев -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core OpenAPI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8"/>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0" PrivateAssets="All"/>

    <!-- MongoDB -->
    <PackageReference Include="MongoDB.Driver" Version="3.9.0"/>

    <!-- Redis -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0"/>

    <!-- Scalar API documentation UI -->
    <PackageReference Include="Scalar.AspNetCore" Version="1.2.5"/>

    <!-- Logging -->
    <PackageReference Include="NLog" Version="5.2.8"/>
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.2"/>
    <PackageReference Include="NLog.Schema" Version="6.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>
</Project>
