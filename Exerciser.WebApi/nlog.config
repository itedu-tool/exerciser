<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwConfigExceptions="false"
      internalLogLevel="Info">

  <!-- Define variables -->
  <variable name="logDirectory" value="${basedir}/logs"/>

  <!-- Define all targets -->
  <targets async="true">

    <!-- Colored console target -->
    <target xsi:type="ColoredConsole"
            name="coloredConsole"
            useDefaultRowHighlightingRules="false"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}|${level:uppercase=true:padding=5}|${logger:padding=25}|${message}${onexception:${newline}${exception:format=tostring}}">

      <highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray"/>
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray"/>
      <highlight-row condition="level == LogLevel.Info" foregroundColor="Green"/>
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow"/>
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red"/>
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Magenta" backgroundColor="Red"/>
    </target>

    <!-- File target with JSON layout -->
    <target xsi:type="File"
            name="fileJson"
            fileName="${logDirectory}/app-${shortdate}.json"
            archiveFileName="${logDirectory}/archive/app-{#}.json"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8">
      <layout type="JsonLayout">
        <attribute name="timestamp" layout="${date:format=O}"/>
        <attribute name="level" layout="${level}"/>
        <attribute name="logger" layout="${logger}"/>
        <attribute name="message" layout="${message}"/>
        <attribute name="exception" layout="${exception:format=tostring}"/>
      </layout>
    </target>

    <!-- File target with text layout -->
    <target xsi:type="File"
            name="fileText"
            fileName="${logDirectory}/app-${shortdate}.log"
            archiveFileName="${logDirectory}/archive/app-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}|${level:uppercase=true:padding=5}|${logger:padding=30}|${message}${onexception:${newline}EXCEPTION: ${exception:format=tostring}}"/>

    <!-- File target for errors only -->
    <target xsi:type="File"
            name="fileError"
            fileName="${logDirectory}/app-errors-${shortdate}.log"
            archiveFileName="${logDirectory}/archive/app-errors-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff}|${level:uppercase=true}|${logger}|${message}${newline}${exception:format=tostring}"/>

    <!-- Null target -->
    <target xsi:type="Null" name="blackhole"/>

  </targets>

  <!-- Define rules -->
  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" writeTo="blackhole"/>
    <logger name="System.*" maxlevel="Info" final="true" writeTo="blackhole"/>

    <logger name="*" minlevel="Error" writeTo="coloredConsole,fileJson,fileText,fileError"/>
    <logger name="Exerciser.*" minlevel="Trace" writeTo="coloredConsole,fileJson,fileText"/>
    <logger name="*" minlevel="Info" writeTo="coloredConsole,fileJson,fileText"/>
  </rules>
</nlog>