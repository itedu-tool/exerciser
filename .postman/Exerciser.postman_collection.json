{
  "info": {
    "_postman_id": "exerciser-api-collection",
    "name": "Exerciser API",
    "description": "Система тестирования студентов. REST API для управления экзаменами и импорта вопросов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.1.0"
  },
  "item": [
    {
      "name": "Health",
      "description": "Проверка здоровья API",
      "item": [
        {
          "name": "Health Check (Legacy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has healthy status', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal('healthy');",
                  "});",
                  "",
                  "pm.test('Response has timestamp', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData).to.have.property('timestampUtc');",
                  "    pm.expect(jsonData).to.have.property('timeZone');",
                  "});",
                  "",
                  "pm.test('Response does NOT have apiVersion', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.not.have.property('apiVersion');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка здоровья API (legacy endpoint без версии)"
          },
          "response": []
        },
        {
          "name": "Health Check v1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has healthy status', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal('healthy');",
                  "});",
                  "",
                  "pm.test('Response contains apiVersion = v1', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('apiVersion', 'v1');",
                  "});",
                  "",
                  "pm.test('Health check response format', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData).to.have.property('timestampUtc');",
                  "    pm.expect(jsonData).to.have.property('timeZone');",
                  "    pm.expect(jsonData).to.have.property('offset');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "health"
              ]
            },
            "description": "Проверка здоровья API (v1 endpoint)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Exams",
      "description": "Управление экзаменами",
      "item": [
        {
          "name": "Import Exam - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set('request_timestamp', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 (Created)', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has exam data', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('questionsCount');",
                  "});",
                  "",
                  "pm.test('Questions count is correct', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.questionsCount).to.be.greaterThan(0);",
                  "});",
                  "",
                  "// Сохранить ID экзамена для дальнейшего использования",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('exam_id', jsonData.id);",
                  "pm.environment.set('last_exam_id', jsonData.id);",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{exam_file_path}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "import"
              ]
            },
            "description": "Импорт экзамена из JSON файла. Успешный сценарий."
          },
          "response": []
        },
        {
          "name": "Get All Exams",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function() {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each exam has required fields', function() {",
                  "    var exams = pm.response.json();",
                  "    if (exams.length > 0) {",
                  "        exams.forEach(exam => {",
                  "            pm.expect(exam).to.have.property('id');",
                  "            pm.expect(exam).to.have.property('title');",
                  "            pm.expect(exam).to.have.property('questionsCount');",
                  "        });",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams"
              ]
            },
            "description": "Получить список всех экзаменов (только метаданные)"
          },
          "response": []
        },
        {
          "name": "Get Exam by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('exam_id')) {",
                  "    console.warn('exam_id not set. Please run Import Exam first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains exam details', function() {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data).to.have.property('title');",
                  "    pm.expect(data).to.have.property('questions');",
                  "    pm.expect(data.questions).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each question has required fields', function() {",
                  "    var data = pm.response.json();",
                  "    data.questions.forEach(q => {",
                  "        pm.expect(q).to.have.property('id');",
                  "        pm.expect(q).to.have.property('text');",
                  "        pm.expect(q).to.have.property('type');",
                  "        pm.expect(q).to.have.property('correctAnswers');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/{{exam_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "{{exam_id}}"
              ]
            },
            "description": "Получить полную информацию об экзамене (включая вопросы и ответы)"
          },
          "response": []
        },
        {
          "name": "Delete Exam by ID",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('exam_id')) {",
                  "    console.warn('exam_id not set. Please run Import Exam first.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function() {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('Response body is empty', function() {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});",
                  "",
                  "// Очистить переменную exam_id после удаления",
                  "pm.collectionVariables.unset('exam_id');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/{{exam_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "{{exam_id}}"
              ]
            },
            "description": "Удалить экзамен по ID"
          },
          "response": []
        },
        {
          "name": "Import Exam - Empty File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 (Bad Request)', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has error message', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "import"
              ]
            },
            "description": "Попытка импорта без файла - должна вернуть 400"
          },
          "response": []
        },
        {
          "name": "Import Exam - Invalid JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 (Bad Request)', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has error message about JSON format', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error.toLowerCase()).to.include('json');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "invalid.txt"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "import"
              ]
            },
            "description": "Попытка импорта с неверным форматом файла - должна вернуть 400"
          },
          "response": []
        },
        {
          "name": "Import Exam - Rate Limited",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 429 (Too Many Requests)', function() {",
                  "    pm.response.to.have.status(429);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{exam_file_path}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/exams/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "{{api_version}}",
                "exams",
                "import"
              ]
            },
            "description": "Тест Rate Limiting - отправить более 10 запросов в час (для import endpoint)"
          },
          "response": []
        }
      ]
    },
