{
  "info": {
    "_postman_id": "exerciser-api-collection-v2",
    "name": "Exerciser API",
    "description": "Система тестирования студентов. REST API для управления экзаменами, группами, студентами и попытками.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "Health",
      "description": "Проверка здоровья API",
      "item": [
        {
          "name": "Health Check (Legacy)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has healthy status', function() {",
                  "    pm.expect(pm.response.json().status).to.equal('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Health Check v1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has apiVersion v1', function() {",
                  "    pm.expect(pm.response.json().apiVersion).to.equal('v1');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Exams (Admin)",
      "description": "Управление экзаменами (импорт, просмотр, обновление, удаление)",
      "item": [
        {
          "name": "Import Exam - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('exam_id', jsonData.id);",
                  "pm.environment.set('exam_id', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "{{exam_file_path}}" }]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/exams/import",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "exams", "import"]
            }
          }
        },
        {
          "name": "Get All Exams",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/exams",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "exams"]
            }
          }
        },
        {
          "name": "Get Exam by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/v1/exams/{{exam_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "exams", "{{exam_id}}"]
            }
          }
        },
        {
          "name": "Update Exam",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"description\": \"New description\",\n  \"questions\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/exams/{{exam_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "exams", "{{exam_id}}"]
            }
          }
        },
        {
          "name": "Delete Exam",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/exams/{{exam_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "exams", "{{exam_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Groups & Students",
      "description": "Управление группами и студентами (административные эндпоинты)",
      "item": [
        {
          "name": "Get All Groups",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            }
          }
        },
        {
          "name": "Create Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('group_id', jsonData.id);",
                  "pm.environment.set('group_id', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Группа 1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            }
          }
        },
        {
          "name": "Import Group from JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('group_id', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "{{group_file_path}}" }]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups/import",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "import"]
            }
          }
        },
        {
          "name": "Add Student to Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('student_id', jsonData.id);",
                  "pm.environment.set('student_id', jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"Иванов\",\n  \"firstName\": \"Иван\",\n  \"patronymic\": \"Иванович\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{group_id}}/students",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{group_id}}", "students"]
            }
          }
        }
      ]
    },
    {
      "name": "Student Session & Attempts",
      "description": "Студенческая часть: сессии, попытки, результаты",
      "item": [
        {
          "name": "Start Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var session = pm.response.json();",
                  "pm.collectionVariables.set('session_id', session.sessionId);",
                  "pm.environment.set('session_id', session.sessionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"{{group_id}}\",\n  \"studentId\": \"{{student_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/sessions/start",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sessions", "start"]
            }
          }
        },
        {
          "name": "Start Attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var attempt = pm.response.json();",
                  "pm.collectionVariables.set('attempt_id', attempt.attemptId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Id", "value": "{{session_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examId\": \"{{exam_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/attempts/start",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "attempts", "start"]
            }
          }
        },
        {
          "name": "Finish Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Session-Id", "value": "{{session_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalScore\": 5,\n  \"finishedAt\": \"{{$iso8601}}\",\n  \"answers\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/attempts/{{attempt_id}}/finish",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "attempts", "{{attempt_id}}", "finish"]
            }
          }
        },
        {
          "name": "Get Attempt Result",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Session-Id", "value": "{{session_id}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/attempts/{{attempt_id}}/result",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "attempts", "{{attempt_id}}", "result"]
            }
          }
        }
      ]
    },
    {
      "name": "API Information",
      "description": "Информация об API",
      "item": [
        {
          "name": "OpenAPI Specification",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/openapi/v1.json",
              "host": ["{{base_url}}"],
              "path": ["openapi", "v1.json"]
            }
          }
        },
        {
          "name": "Scalar UI Documentation",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/scalar/v1",
              "host": ["{{base_url}}"],
              "path": ["scalar", "v1"]
            }
          }
        },
        {
          "name": "Root Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "exam_file_path", "value": "./exam.json", "type": "string" },
    { "key": "group_file_path", "value": "./group.json", "type": "string" },
    { "key": "exam_id", "value": "", "type": "string" },
    { "key": "group_id", "value": "", "type": "string" },
    { "key": "student_id", "value": "", "type": "string" },
    { "key": "session_id", "value": "", "type": "string" },
    { "key": "attempt_id", "value": "", "type": "string" }
  ]
}