extends layout

block vars
    - var title = "Главная"
    - var currentPage = "index"

block content
    .hero.bg-light.p-5.rounded-3.mb-4
        .container-fluid.py-5
            h1.display-5.fw-bold Простая система для преподавателей и студентов
            p.col-md-8.fs-4
                | Загружайте вопросы в формате JSON, управляйте экзаменами, а студенты проходят тестирование прямо в браузере.
            a.btn.btn-primary.btn-lg(href="teacher.html") 👨‍🏫 Управление экзаменами
            a.btn.btn-secondary.btn-lg.ms-3(href="health.html") 🩺 Диагностика API
    .row.row-cols-1.row-cols-md-3.g-4
        .col
            .card.h-100
                .card-body
                    h5.card-title 📥 Импорт из JSON
                    p.card-text Загрузите файл с вопросами и правильными ответами — система сама создаст экзамен.
        .col
            .card.h-100
                .card-body
                    h5.card-title 📋 Управление экзаменами
                    p.card-text Просматривайте список экзаменов, удаляйте ненужные, смотрите вопросы и ответы.
        .col
            .card.h-100
                .card-body
                    h5.card-title 🔍 Проверка API
                    p.card-text Встроенная диагностика позволяет проверить работоспособность всех эндпоинтов сервера.