extends layout

block vars
    - var title = "Управление экзаменами"
    - var currentPage = "teacher"

block content
    section.row
        .col-md-6
            article.card.mb-4
                .card-header
                    h2.h5.mb-0
                        i.bi.bi-file-arrow-down.me-2
                        | Импорт экзамена (JSON)
                .card-body
                    form#importForm
                        .mb-3
                            label.form-label(for="examFile") Выберите JSON-файл
                            input#examFile.form-control(type="file", accept=".json", required)
                        button#uploadBtn.btn.btn-primary(type="submit")
                            i.bi.bi-upload.me-1
                            | Загрузить
                        #importResult.mt-3
        .col-md-6
            article.card.mb-4
                .card-header
                    h2.h5.mb-0
                        i.bi.bi-list-ul.me-2
                        | Список экзаменов
                .card-body
                    #examsList
                        //- Список будет заполнен динамически через JS с использованием <ul>
    .modal.fade#examDetailsModal(tabindex="-1", role="dialog", aria-labelledby="examDetailsModalLabel", aria-modal="true")
        .modal-dialog.modal-lg
            .modal-content
                .modal-header
                    h3.modal-title.h5#examDetailsModalLabel
                        i.bi.bi-eye.me-2
                        | Детали экзамена
                    button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Закрыть")
                .modal-body#examDetailsContent
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal")
                        i.bi.bi-x-circle.me-1
                        | Закрыть

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/teacher.js")
