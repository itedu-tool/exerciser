extends layout

block vars
    - var title = "Управление экзаменами"
    - var currentPage = "teacher"

block content
    .row
        .col-md-6
            .card.mb-4
                .card-header
                    h5.mb-0
                        i.bi.bi-file-arrow-down.me-2
                        | Импорт экзамена (JSON)
                .card-body
                    .mb-3
                        label.form-label Выберите JSON-файл
                        input#examFile.form-control(type="file", accept=".json")
                    button#uploadBtn.btn.btn-primary
                        i.bi.bi-upload.me-1
                        | Загрузить
                    #importResult.mt-3
        .col-md-6
            .card.mb-4
                .card-header
                    h5.mb-0
                        i.bi.bi-list-ul.me-2
                        | Список экзаменов
                .card-body
                    #examsList
                        .text-muted Загрузка...
    .modal.fade#examDetailsModal(tabindex="-1")
        .modal-dialog.modal-lg
            .modal-content
                .modal-header
                    h5.modal-title
                        i.bi.bi-eye.me-2
                        | Детали экзамена
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body#examDetailsContent
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal")
                        i.bi.bi-x-circle.me-1
                        | Закрыть

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/teacher.js")
