extends layout

block vars
    - var title = "Управление группами"
    - var currentPage = "groups"

block content
    .row
        .col-md-12
            .card.mb-4
                .card-header
                    h5.mb-0
                        i.bi.bi-people.me-2
                        | Управление группами и студентами
                .card-body
                    .d-flex.justify-content-between.mb-3
                        button#createGroupBtn.btn.btn-success(type="button")
                            i.bi.bi-plus-circle.me-1
                            | Новая группа
                        button#importGroupBtn.btn.btn-info(type="button")
                            i.bi.bi-folder-open.me-1
                            | Импорт группы (JSON)
                    #groupsList
                        .text-muted Загрузка...

    // Модальное окно создания группы
    .modal.fade#createGroupModal(tabindex="-1")
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title
                        i.bi.bi-person-plus.me-2
                        | Создать новую группу
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    form#createGroupForm
                        .mb-3
                            label.form-label(for="groupName") Название группы *
                            input#groupName.form-control(type="text", required)
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal")
                        i.bi.bi-x-circle.me-1
                        | Отмена
                    button.btn.btn-primary(type="submit")
                        i.bi.bi-check-circle.me-1
                        | Создать

    // Модальное окно импорта группы (файл)
    .modal.fade#importGroupModal(tabindex="-1")
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title
                        i.bi.bi-upload.me-2
                        | Импорт группы из JSON
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    form#importGroupForm
                        .mb-3
                            label.form-label(for="groupFile") JSON-файл группы
                            input#groupFile.form-control(type="file", accept=".json")
                        button.btn.btn-secondary(type="button", data-bs-dismiss="modal")
                            i.bi.bi-x-circle.me-1
                            | Отмена
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-upload.me-1
                            | Импортировать

    // Модальное окно просмотра/добавления студентов
    .modal.fade#studentsModal(tabindex="-1")
        .modal-dialog.modal-lg
            .modal-content
                .modal-header
                    h5.modal-title#studentsModalTitle
                        i.bi.bi-person-lines-fill.me-2
                        | Студенты группы
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    #studentsContent
                    hr
                    h6
                        i.bi.bi-person-add.me-2
                        | Добавить нового студента
                    form#addStudentForm
                        input(type="hidden", id="currentGroupId")
                        .mb-2
                            label.form-label(for="studentLastName") Фамилия
                            input#studentLastName.form-control(type="text", required)
                        .mb-2
                            label.form-label(for="studentFirstName") Имя
                            input#studentFirstName.form-control(type="text", required)
                        .mb-2
                            label.form-label(for="studentPatronymic") Отчество (необязательно)
                            input#studentPatronymic.form-control(type="text")
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-person-plus.me-1
                            | Добавить студента
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal")
                        i.bi.bi-x-circle.me-1
                        | Закрыть

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/groups.js")
