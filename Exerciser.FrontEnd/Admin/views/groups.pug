extends layout

block vars
    - var title = "Управление группами"
    - var currentPage = "groups"

block content
    .row
        .col-md-12
            .card.mb-4
                .card-header
                    h5.mb-0 👥 Управление группами и студентами
                .card-body
                    .d-flex.justify-content-between.mb-3
                        button#createGroupBtn.btn.btn-success(type="button") + Новая группа
                        button#importGroupBtn.btn.btn-info(type="button") 📂 Импорт группы (JSON)
                    #groupsList
                        .text-muted Загрузка...

    // Модальное окно создания группы
    .modal.fade#createGroupModal(tabindex="-1")
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title Создать новую группу
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    form#createGroupForm
                        .mb-3
                            label.form-label(for="groupName") Название группы *
                            input#groupName.form-control(type="text", required)
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Отмена
                    button.btn.btn-primary(type="submit") Создать

    // Модальное окно импорта группы (файл)
    .modal.fade#importGroupModal(tabindex="-1")
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title Импорт группы из JSON
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    form#importGroupForm
                        .mb-3
                            label.form-label(for="groupFile") JSON-файл группы
                            input#groupFile.form-control(type="file", accept=".json")
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Отмена
                    button.btn.btn-primary(type="submit") Импортировать

    // Модальное окно просмотра/добавления студентов
    .modal.fade#studentsModal(tabindex="-1")
        .modal-dialog.modal-lg
            .modal-content
                .modal-header
                    h5.modal-title#studentsModalTitle Студенты группы
                    button.btn-close(type="button", data-bs-dismiss="modal")
                .modal-body
                    #studentsContent
                    hr
                    h6 Добавить нового студента
                    form#addStudentForm
                        input(type="hidden", id="currentGroupId")
                        .mb-2
                            label.form-label(for="studentLastName") Фамилия
                            input#studentLastName.form-control(type="text", required)
                        .mb-2
                            label.form-label(for="studentFirstName") Имя
                            input#studentFirstName.form-control(type="text", required)
                        .mb-2
                            label.form-label(for="studentPatronymic") Отчество (необязательно)
                            input#studentPatronymic.form-control(type="text")
                        button.btn.btn-primary(type="submit") Добавить студента
                .modal-footer
                    button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Закрыть

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/groups.js")
