extends layout

block vars
    - var title = "Диагностика API"
    - var currentPage = "health"

block content
    .card
        .card-header
            h5.mb-0 🔍 Проверка работоспособности API
        .card-body
            .list-group.mb-3
                each endpoint in ['/health', '/', '/openapi/v1.json', '/scalar/v1', '/api/v1/health']
                    .list-group-item.d-flex.justify-content-between.align-items-center
                        code #{endpoint}
                        button.btn.btn-sm.btn-outline-primary.test-btn(data-endpoint=endpoint) Проверить
            #healthResult

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/health.js")
