extends layout

block vars
    - var title = "Диагностика API"
    - var currentPage = "health"

block content
    section.card
        .card-header
            h2.h5.mb-0
                i.bi.bi-heart-pulse.me-2
                | Проверка работоспособности API
        .card-body
            ul.list-group.mb-3
                each endpoint in ['/health', '/', '/openapi/v1.json', '/scalar/v1', '/api/v1/health']
                    li.list-group-item.d-flex.justify-content-between.align-items-center
                        code #{endpoint}
                        button.btn.btn-sm.btn-outline-primary.test-btn(type="button", data-endpoint=endpoint)
                            i.bi.bi-play-circle.me-1
                            | Проверить
            #healthResult

block scripts
    script(src="scripts/utils.js")
    script(src="scripts/health.js")
