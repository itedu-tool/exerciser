doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")

        title Exerciser – #{title}

        link#theme-stylesheet(rel="stylesheet", href="https://bootswatch.com/5/flatly/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")

        include includes/config.pug

        block head
    body
        block vars
            - var title = "Exerciser"
            - var currentPage = ""
        nav.navbar.navbar-expand-lg.bg-dark(data-bs-theme="dark")
            .container-fluid
                a.navbar-brand(href="index.html")
                    i.bi.bi-book.me-2
                    | Exerciser
                button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
                    span.navbar-toggler-icon
                .collapse.navbar-collapse(id="navbarNav")
                    ul.navbar-nav.ms-auto
                        li.nav-item
                            a.nav-link(href="index.html", class=currentPage === 'index' ? 'active' : '')
                                i.bi.bi-house.me-1
                                | Главная
                        li.nav-item
                            a.nav-link(href="teacher.html", class=currentPage === 'teacher' ? 'active' : '')
                                i.bi.bi-journal.me-1
                                | Экзамены
                        li.nav-item
                            a.nav-link(href="groups.html", class=currentPage === 'groups' ? 'active' : '')
                                i.bi.bi-people.me-1
                                | Группы
                        li.nav-item
                            a.nav-link(href="analytics.html", class=currentPage === 'analytics' ? 'active' : '')
                                i.bi.bi-bar-chart.me-1
                                | Аналитика
                        li.nav-item
                            a.nav-link(href="health.html", class=currentPage === 'health' ? 'active' : '')
                                i.bi.bi-heart-pulse.me-1
                                | Диагностика API
                        li.nav-item.dropdown
                            a.nav-link.dropdown-toggle(href="#", role="button", data-bs-toggle="dropdown")
                                i.bi.bi-palette.me-1
                                | Тема
                            ul.dropdown-menu.dropdown-menu-end#theme-selector
        main.container.mt-4
            block content
        footer.text-center.mt-5.py-3.text-muted.border-top
            p.mb-0 © 2026 Exerciser – система тестирования студентов
                a.ms-2(href="https://github.com/itedu-tool/exerciser") GitHub
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
        script.
            (function() {
                const themeStylesheet = document.getElementById('theme-stylesheet');
                const themeSelector = document.getElementById('theme-selector');
                const themes = window.AVAILABLE_THEMES || [];

                if (themeSelector && themes.length) {
                    themeSelector.innerHTML = '';
                    themes.forEach(theme => {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.href = '#';
                        a.className = 'dropdown-item';
                        a.setAttribute('data-theme', theme.id);
                        a.textContent = theme.name;
                        a.addEventListener('click', function(e) {
                            e.preventDefault();
                            themeStylesheet.href = theme.url;
                            localStorage.setItem('exerciser-theme', theme.id);
                        });
                        li.appendChild(a);
                        themeSelector.appendChild(li);
                    });
                }

                const savedThemeId = localStorage.getItem('exerciser-theme');
                if (savedThemeId) {
                    const savedTheme = themes.find(t => t.id === savedThemeId);
                    if (savedTheme) {
                        themeStylesheet.href = savedTheme.url;
                    } else if (themes.length) {
                        themeStylesheet.href = themes[0].url;
                    }
                } else if (themes.length) {
                    themeStylesheet.href = themes[0].url;
                }
            })();
        block scripts
