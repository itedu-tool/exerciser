doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Exerciser – #{title}
        link#theme-stylesheet(rel="stylesheet", href="https://bootswatch.com/5/flatly/bootstrap.min.css")
        include includes/config.pug
        block head
    body
        block vars
            - var title = "Exerciser"
            - var currentPage = ""
        nav.navbar.navbar-expand-lg.bg-dark(data-bs-theme="dark")
            .container-fluid
                a.navbar-brand(href="index.html") 📚 Exerciser
                button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
                    span.navbar-toggler-icon
                .collapse.navbar-collapse(id="navbarNav")
                    ul.navbar-nav.ms-auto
                        li.nav-item
                            a.nav-link(href="index.html", class=currentPage === 'index' ? 'active' : '') Главная
                        li.nav-item
                            a.nav-link(href="teacher.html", class=currentPage === 'teacher' ? 'active' : '') Управление экзаменами
                        li.nav-item
                            a.nav-link(href="health.html", class=currentPage === 'health' ? 'active' : '') Диагностика API
                        li.nav-item.dropdown
                            a.nav-link.dropdown-toggle(href="#", role="button", data-bs-toggle="dropdown") 🎨 Тема
                            ul.dropdown-menu.dropdown-menu-end#theme-selector
                                // Пункты меню будут добавлены скриптом динамически из config
        main.container.mt-4
            block content
        footer.text-center.mt-5.py-3.text-muted.border-top
            p.mb-0 © 2026 Exerciser – система тестирования студентов
                a.ms-2(href="https://github.com/itedu-tool/exerciser") GitHub
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
        script.
            // Динамическое создание меню тем из конфигурации
            (function() {
                const themeStylesheet = document.getElementById('theme-stylesheet');
                const themeSelector = document.getElementById('theme-selector');
                const themes = window.AVAILABLE_THEMES || [];

                if (themeSelector && themes.length) {
                    themeSelector.innerHTML = ''; // очищаем (на случай повторного вызова)
                    themes.forEach(theme => {
                        const li = document.createElement('li');
                        const a = document.createElement('a');
                        a.href = '#';
                        a.className = 'dropdown-item';
                        a.setAttribute('data-theme', theme.id);
                        a.textContent = theme.name;
                        a.addEventListener('click', function(e) {
                            e.preventDefault();
                            themeStylesheet.href = theme.url;
                            localStorage.setItem('exerciser-theme', theme.id);
                        });
                        li.appendChild(a);
                        themeSelector.appendChild(li);
                    });
                }

                // Загрузка сохранённой темы
                const savedThemeId = localStorage.getItem('exerciser-theme');
                if (savedThemeId) {
                    const savedTheme = themes.find(t => t.id === savedThemeId);
                    if (savedTheme) {
                        themeStylesheet.href = savedTheme.url;
                    } else if (themes.length) {
                        themeStylesheet.href = themes[0].url;
                    }
                } else if (themes.length) {
                    themeStylesheet.href = themes[0].url;
                }
            })();
        block scripts
            script(src="scripts/utils.js")
